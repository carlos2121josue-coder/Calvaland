PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
# In Vercel, set this to the public site origin(s), comma-separated. Vercel deployment URLs are allowed automatically.
WEB_ORIGIN=http://localhost:5173

# Admin created by `npm run db:admin`
ADMIN_NAME=Administración
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Currency displayed by the local-only payment simulator. It cannot charge money.
PAYMENT_CURRENCY=USD

# Email through Resend. Verify the sender domain in Resend first.
RESEND_API_KEY=
RECEIPT_FROM="MesaLista <comprobantes@tu-dominio-verificado.com>"

# Rental rates in cents per item, per calendar day
PRICE_TABLE_CENTS=1000
PRICE_CHAIR_CENTS=500
